# Copy to .env and fill in your own values. Never commit .env.

# Local pgvector database (docker-compose.yml)
POSTGRES_USER=taxcopilot
POSTGRES_PASSWORD=
POSTGRES_DB=taxcopilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
DATABASE_URL=

# Hosted model providers (D-03). LLM_API_KEY: Claude API key for generation (Phase 5, D-27),
# passed to the client explicitly. EMBEDDING_API_KEY: OpenAI key for embeddings (Phase 3).
LLM_API_KEY=
EMBEDDING_API_KEY=
